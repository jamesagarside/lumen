# Lumen — local dev environment variables.
# Copy to .env (which is gitignored) and fill in.
# dotenvy loads this at daemon startup; no need to export.

# ─── Auth bootstrap ──────────────────────────────────────────────────────
# Required on the very first start. Creates an Admin user in the
# topology DB. After that the values are ignored. If you forget to set
# these, the daemon logs a warning and nobody can log in until you do.
LUMEN_INITIAL_ADMIN_EMAIL=you@example.com
LUMEN_INITIAL_ADMIN_PASSWORD=

# ─── Integration config (preferred path: admin UI) ───────────────────────
# All third-party integrations (UniFi labels, UniFi IPS, outbound
# webhook) are now managed at runtime in the admin Settings page —
# secrets are encrypted at rest with the master key (see below).
# The env vars below still work as a fallback so existing deployments
# keep running on upgrade, but new installs should leave them blank
# and use the UI. If both are set, the DB value wins.
#
# UniFi Network Integration API (auto-labels nodes):
# UDM_URL=https://192.168.0.1/proxy/network/integration/v1/sites
# UDM_API_KEY=
#
# UniFi IPS/IDS alarm polling (legacy cookie auth):
# UDM_CONTROLLER_URL=https://192.168.0.1
# UDM_USERNAME=
# UDM_PASSWORD=
# UDM_SITE=default
#
# Outbound detection webhook:
# LUMEN_DETECTION_WEBHOOK_URL=https://hooks.slack.com/services/...

# ─── Secret-store master key (optional) ──────────────────────────────────
# Lumen encrypts admin-managed secrets with ChaCha20-Poly1305. The
# 32-byte master key is auto-generated at $LUMEN_DATA_DIR/master.key
# on first run (mode 0600). Override here for container deployments
# where the key lives in a secrets manager — 64 hex chars = 32 bytes.
#   openssl rand -hex 32
# Losing this key means losing every stored secret. Back it up.
# LUMEN_MASTER_KEY=

# ─── Ingestion (defaults shown) ──────────────────────────────────────────
# LUMEN_NETFLOW_V5_LISTEN=0.0.0.0:2055        # v5/v9/IPFIX share this port
# LUMEN_SYSLOG_LISTEN=0.0.0.0:5514            # off by default; uncomment to enable
# LUMEN_INGEST_API_KEY=                       # optional gate for POST /ingest/flows

# ─── Persistence ─────────────────────────────────────────────────────────
# LUMEN_DATA_DIR=./data
# LUMEN_EDGE_MAX_AGE_SECS=300
# LUMEN_EVICTION_INTERVAL_SECS=30

# ─── Observability (optional) ────────────────────────────────────────────
# LUMEN_LOG_FORMAT=json                       # or 'compact'
# RUST_LOG=info,lumen_daemon=info,lumen::integrations=debug
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=lumen
